# .env.example — names and placeholders only. Values in <angle brackets> are placeholders.
# Keep comments on their own lines. Copy to apps/api/.env and (NEXT_PUBLIC_* lines only) apps/web/.env.local.
# ---------- application ----------
APP_ENV=local
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MIN=60
BUILD_VERSION=dev
PORT=8000
# Comma-separated switch names; EXT names: ranking_explain, nl_intake, day_explain, optimise_order, rain_swap, today_view, budget_fit, context_cards, packing
FEATURES_DISABLED=
# ---------- database and authentication (backend, secret) ----------
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:54322/postgres
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/travel_test
SUPABASE_URL=http://127.0.0.1:54321
# Use ONE of the next two (OD-06): JWKS URL for asymmetric keys, or the shared secret.
SUPABASE_JWKS_URL=
SUPABASE_JWT_SECRET=<JWT_SECRET from supabase status -o env>
# ---------- web app (public by design) ----------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<ANON_KEY from supabase status -o env>
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_FEATURES_DISABLED=
# ---------- routing (backend, secret) ----------
ORS_API_KEY=<OpenRouteService key; leave empty to use the distance estimate>
ORS_TIMEOUT_S=8
# ---------- AI provider ----------
# AI_PROVIDER is one of: GEMINI | MOCK | FINETUNED_MODEL (Stage 2 only)
AI_PROVIDER=MOCK
# MOCK_PROVIDER_SCENARIO is one of: ok | flawed | timeout | rate_limited | quota | invalid_json | unknown_place
MOCK_PROVIDER_SCENARIO=ok
PROMPT_TEMPLATE_VERSION=v1
# Do not set any other Google key variable: the SDK would prefer it to GEMINI_API_KEY.
GEMINI_API_KEY=<Gemini API key>
GEMINI_MODEL_ID=<model identifier from the provider's current model list>
GEMINI_TIMEOUT_S=35
GEMINI_MAX_RETRIES=1
AI_TEMPERATURE=0.4
AI_MAX_INPUT_TOKENS=
AI_MAX_OUTPUT_TOKENS=
AI_DAILY_GENERATIONS_PER_USER=10
AI_DAILY_GENERATIONS_GLOBAL=200
# Assistive AI calls (EXT): intake, day explanation, packing refinement
AI_DAILY_ASSIST_CALLS_PER_USER=30
# ---------- extension services (backend, no key) ----------
WEATHER_TIMEOUT_S=8
WIKI_USER_AGENT=<AITravelPlanner/1.0 (contact: team email)>
# ---------- Stage 2 placeholders (empty in Stage 1) ----------
FINETUNED_ENDPOINT_URL=
FINETUNED_API_KEY=
FINETUNED_MODEL_NAME=
# ---------- local E2E only (never commit a value) ----------
SUPABASE_SERVICE_ROLE_KEY=<SERVICE_ROLE_KEY from supabase status -o env>
# ---------- Makefile variable (optional) ----------
SEED_DIRS=
