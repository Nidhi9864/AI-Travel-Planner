{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-travel-planner:schema:gr-1",
  "$defs": {
    "Budget": {
      "additionalProperties": false,
      "description": "Group total for the whole trip.",
      "properties": {
        "amount": {
          "description": "Amount as a two-decimal string",
          "pattern": "^\\d{1,10}\\.\\d{2}$",
          "title": "Amount",
          "type": "string"
        },
        "currency": {
          "description": "ISO 4217 code",
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "title": "Budget",
      "type": "object"
    },
    "DayHint": {
      "additionalProperties": false,
      "properties": {
        "day_number": {
          "maximum": 14,
          "minimum": 1,
          "title": "Day Number",
          "type": "integer"
        },
        "place_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Place Ids",
          "type": "array"
        }
      },
      "required": [
        "day_number",
        "place_ids"
      ],
      "title": "DayHint",
      "type": "object"
    },
    "Limits": {
      "additionalProperties": false,
      "properties": {
        "max_items_per_day": {
          "maximum": 12,
          "minimum": 1,
          "title": "Max Items Per Day",
          "type": "integer"
        },
        "max_active_minutes_per_day": {
          "exclusiveMinimum": 0,
          "title": "Max Active Minutes Per Day",
          "type": "integer"
        },
        "day_start": {
          "description": "24-hour time HH:MM in the destination time zone",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
          "title": "Day Start",
          "type": "string"
        },
        "day_end": {
          "description": "24-hour time HH:MM in the destination time zone",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
          "title": "Day End",
          "type": "string"
        },
        "meal_slots": {
          "items": {
            "type": "string"
          },
          "title": "Meal Slots",
          "type": "array"
        }
      },
      "required": [
        "max_items_per_day",
        "max_active_minutes_per_day",
        "day_start",
        "day_end",
        "meal_slots"
      ],
      "title": "Limits",
      "type": "object"
    },
    "LockedItem": {
      "additionalProperties": false,
      "properties": {
        "day_number": {
          "maximum": 14,
          "minimum": 1,
          "title": "Day Number",
          "type": "integer"
        },
        "place_id": {
          "format": "uuid",
          "title": "Place Id",
          "type": "string"
        },
        "start_time": {
          "description": "24-hour time HH:MM in the destination time zone",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
          "title": "Start Time",
          "type": "string"
        },
        "duration_min": {
          "maximum": 480,
          "minimum": 15,
          "title": "Duration Min",
          "type": "integer"
        }
      },
      "required": [
        "day_number",
        "place_id",
        "start_time",
        "duration_min"
      ],
      "title": "LockedItem",
      "type": "object"
    },
    "PlanFinding": {
      "additionalProperties": false,
      "description": "A validator finding as the repair call sees it (§8.12, §8.18).",
      "properties": {
        "code": {
          "enum": [
            "OVERLAP",
            "TRANSFER_TOO_SHORT",
            "CLOSED_ON_DAY",
            "OUTSIDE_HOURS",
            "HOURS_UNVERIFIED",
            "DAY_TOO_LONG",
            "BUDGET_EXCEEDED",
            "BUDGET_NEAR",
            "MUST_VISIT_MISSING",
            "UNKNOWN_PLACE",
            "OUTSIDE_TRIP_DATES",
            "COST_INCOMPLETE",
            "ESTIMATE_USED"
          ],
          "title": "Code",
          "type": "string"
        },
        "severity": {
          "enum": [
            "error",
            "warning",
            "info"
          ],
          "title": "Severity",
          "type": "string"
        },
        "day_number": {
          "anyOf": [
            {
              "maximum": 14,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Day Number"
        },
        "item_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Item as d<day>-i<position>",
          "title": "Item Ref"
        },
        "place_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Set only for MUST_VISIT_MISSING",
          "title": "Place Id"
        },
        "message": {
          "maxLength": 500,
          "title": "Message",
          "type": "string"
        },
        "suggested_fix": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Suggested Fix"
        }
      },
      "required": [
        "code",
        "severity",
        "day_number",
        "message"
      ],
      "title": "PlanFinding",
      "type": "object"
    },
    "Preferences": {
      "additionalProperties": false,
      "properties": {
        "interests": {
          "items": {
            "enum": [
              "sight",
              "museum",
              "nature",
              "food",
              "shopping",
              "entertainment",
              "religious",
              "activity"
            ],
            "type": "string"
          },
          "title": "Interests",
          "type": "array"
        },
        "pace": {
          "enum": [
            "relaxed",
            "balanced",
            "busy"
          ],
          "title": "Pace",
          "type": "string"
        },
        "budget_priority": {
          "enum": [
            "saving",
            "balanced",
            "comfort"
          ],
          "title": "Budget Priority",
          "type": "string"
        },
        "transport_pref": {
          "enum": [
            "walking",
            "local_transport",
            "car"
          ],
          "title": "Transport Pref",
          "type": "string"
        },
        "accommodation_type": {
          "enum": [
            "budget",
            "mid_range",
            "premium",
            "any"
          ],
          "title": "Accommodation Type",
          "type": "string"
        },
        "step_free_required": {
          "title": "Step Free Required",
          "type": "boolean"
        },
        "notes_quoted": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Notes Quoted"
        }
      },
      "required": [
        "interests",
        "pace",
        "budget_priority",
        "transport_pref",
        "accommodation_type",
        "step_free_required",
        "notes_quoted"
      ],
      "title": "Preferences",
      "type": "object"
    },
    "RepairContext": {
      "additionalProperties": false,
      "description": "Sent only on the one repair call of step 10 (§8.13).",
      "properties": {
        "invalid_output": {
          "title": "Invalid Output",
          "type": "string"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/PlanFinding"
          },
          "title": "Findings",
          "type": "array"
        }
      },
      "required": [
        "invalid_output",
        "findings"
      ],
      "title": "RepairContext",
      "type": "object"
    },
    "Scope": {
      "additionalProperties": false,
      "description": "`full` for API-22 and API-31; `day` with its day number for API-30.",
      "properties": {
        "kind": {
          "enum": [
            "full",
            "day"
          ],
          "title": "Kind",
          "type": "string"
        },
        "day_number": {
          "anyOf": [
            {
              "maximum": 14,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Day Number"
        }
      },
      "required": [
        "kind",
        "day_number"
      ],
      "title": "Scope",
      "type": "object"
    },
    "ShortlistPlace": {
      "additionalProperties": false,
      "properties": {
        "place_id": {
          "format": "uuid",
          "title": "Place Id",
          "type": "string"
        },
        "name": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "category": {
          "enum": [
            "sight",
            "museum",
            "nature",
            "food",
            "shopping",
            "entertainment",
            "religious",
            "activity",
            "stay"
          ],
          "title": "Category",
          "type": "string"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "lat": {
          "maximum": 90,
          "minimum": -90,
          "title": "Lat",
          "type": "number"
        },
        "lon": {
          "maximum": 180,
          "minimum": -180,
          "title": "Lon",
          "type": "number"
        },
        "typical_duration_min": {
          "maximum": 480,
          "minimum": 15,
          "title": "Typical Duration Min",
          "type": "integer"
        },
        "price_min": {
          "anyOf": [
            {
              "description": "Amount as a two-decimal string",
              "pattern": "^\\d{1,10}\\.\\d{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Price Min"
        },
        "price_max": {
          "anyOf": [
            {
              "description": "Amount as a two-decimal string",
              "pattern": "^\\d{1,10}\\.\\d{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Price Max"
        },
        "price_label": {
          "enum": [
            "estimate",
            "curated",
            "unavailable"
          ],
          "title": "Price Label",
          "type": "string"
        },
        "hours_summary": {
          "title": "Hours Summary",
          "type": "string"
        },
        "suitability": {
          "$ref": "#/$defs/Suitability"
        }
      },
      "required": [
        "place_id",
        "name",
        "category",
        "tags",
        "lat",
        "lon",
        "typical_duration_min",
        "price_min",
        "price_max",
        "price_label",
        "hours_summary",
        "suitability"
      ],
      "title": "ShortlistPlace",
      "type": "object"
    },
    "Suitability": {
      "additionalProperties": false,
      "description": "Null means unknown.",
      "properties": {
        "step_free": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Step Free"
        },
        "child_friendly": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Child Friendly"
        }
      },
      "required": [
        "step_free",
        "child_friendly"
      ],
      "title": "Suitability",
      "type": "object"
    },
    "Travellers": {
      "additionalProperties": false,
      "properties": {
        "adults": {
          "maximum": 20,
          "minimum": 1,
          "title": "Adults",
          "type": "integer"
        },
        "children": {
          "maximum": 20,
          "minimum": 0,
          "title": "Children",
          "type": "integer"
        }
      },
      "required": [
        "adults",
        "children"
      ],
      "title": "Travellers",
      "type": "object"
    },
    "TripContext": {
      "additionalProperties": false,
      "properties": {
        "destination_id": {
          "format": "uuid",
          "title": "Destination Id",
          "type": "string"
        },
        "start_date": {
          "format": "date",
          "title": "Start Date",
          "type": "string"
        },
        "end_date": {
          "format": "date",
          "title": "End Date",
          "type": "string"
        },
        "num_days": {
          "maximum": 14,
          "minimum": 1,
          "title": "Num Days",
          "type": "integer"
        },
        "travellers": {
          "$ref": "#/$defs/Travellers"
        },
        "group_needs": {
          "items": {
            "enum": [
              "children",
              "older_adults",
              "reduced_mobility"
            ],
            "type": "string"
          },
          "title": "Group Needs",
          "type": "array"
        },
        "budget": {
          "anyOf": [
            {
              "$ref": "#/$defs/Budget"
            },
            {
              "type": "null"
            }
          ]
        },
        "contingency_pct": {
          "maximum": 50,
          "minimum": 0,
          "title": "Contingency Pct",
          "type": "number"
        }
      },
      "required": [
        "destination_id",
        "start_date",
        "end_date",
        "num_days",
        "travellers",
        "group_needs",
        "budget",
        "contingency_pct"
      ],
      "title": "TripContext",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "gr-1: built by the backend from database rows only; it never holds personal data (§8.6).",
  "properties": {
    "input_schema_version": {
      "const": "gr-1",
      "default": "gr-1",
      "title": "Input Schema Version",
      "type": "string"
    },
    "request_id": {
      "format": "uuid",
      "title": "Request Id",
      "type": "string"
    },
    "trip": {
      "$ref": "#/$defs/TripContext"
    },
    "preferences": {
      "$ref": "#/$defs/Preferences"
    },
    "must_visit_place_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "maxItems": 10,
      "title": "Must Visit Place Ids",
      "type": "array"
    },
    "shortlist": {
      "items": {
        "$ref": "#/$defs/ShortlistPlace"
      },
      "title": "Shortlist",
      "type": "array"
    },
    "day_hints": {
      "items": {
        "$ref": "#/$defs/DayHint"
      },
      "title": "Day Hints",
      "type": "array"
    },
    "limits": {
      "$ref": "#/$defs/Limits"
    },
    "locked_items": {
      "items": {
        "$ref": "#/$defs/LockedItem"
      },
      "title": "Locked Items",
      "type": "array"
    },
    "scope": {
      "$ref": "#/$defs/Scope"
    },
    "repair_context": {
      "anyOf": [
        {
          "$ref": "#/$defs/RepairContext"
        },
        {
          "type": "null"
        }
      ]
    },
    "prompt_template_id": {
      "minLength": 1,
      "title": "Prompt Template Id",
      "type": "string"
    },
    "prompt_version": {
      "minLength": 1,
      "title": "Prompt Version",
      "type": "string"
    }
  },
  "required": [
    "request_id",
    "trip",
    "preferences",
    "must_visit_place_ids",
    "shortlist",
    "day_hints",
    "limits",
    "locked_items",
    "scope",
    "repair_context",
    "prompt_template_id",
    "prompt_version"
  ],
  "title": "GenerationRequest",
  "type": "object"
}
